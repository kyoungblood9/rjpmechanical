---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Services | RJP Mechanical">

<!-- HERO -->
<section style="
  position:relative;
  padding:110px 20px 90px;
  background:
    linear-gradient(
      rgba(8,22,38,0.82),
      rgba(8,22,38,0.82)
    ),
    url('/images/mechanical.jpg') center/cover no-repeat;
  text-align:center;
  color:white;
  overflow:hidden;
">

   <div style="
      max-width:950px;
      margin:auto;
      position:relative;
      z-index:2;
    ">

      <p style="
        color:#b4232c;
        font-weight:800;
        letter-spacing:2px; 
        text-transform:uppercase;
        margin-bottom:18px;
        font-size:30px;
      ">
        Services
      </p>

      <h1 style="
  font-size:clamp(38px,4.5vw,58px);
  line-height:1.12;
  margin-bottom:30px;
  font-weight:700;
  letter-spacing:-1px;
      ">
        Commercial HVAC Expertise Built Around Real-World Performance
      </h1>

      <div style="
        width:80px;
        height:4px;
        background:#b4232c;
        margin:0 auto 34px auto;
      "></div>

<p style="
  font-size:20px;
  line-height:1.9;
  color:#d7d7d7;
  max-width:820px;
  margin:auto;
  font-style:italic;
">
     Engineered mechanical services focused on
coordination, constructability, operational efficiency,
and long-term performance across commercial
and industrial facilities.
      </p>

    </div>

  </section>

  <!-- MAIN SERVICES -->
<section style="
  background:#ffffff;
  padding:110px 20px;
">

  <div class="container">

    <div style="
      text-align:center;
      max-width:950px;
      margin:0 auto 80px auto;
    ">

      <p style="
        color:#b4232c;
        font-weight:800;
        letter-spacing:2px;
        text-transform:uppercase;
        margin-bottom:18px;
        font-size:20px;
      ">
        Commercial HVAC Services
      </p>

      <h2 style="
        font-size:clamp(38px,4.5vw,58px);
        line-height:1.12;
        margin-bottom:30px;
        font-weight:700;
        letter-spacing:-1px;
        color:#081626;
      ">
        Practical HVAC Solutions for Modern Facilities
      </h2>

      <div style="
        width:80px;
        height:4px;
        background:#b4232c;
        margin:0 auto 34px auto;
      "></div>

      <p style="
        font-size:20px;
        line-height:1.9;
        color:#5b6573;
        max-width:820px;
        margin:auto;
        font-style:italic;
      ">
        HVAC consulting, coordination, and engineered
        mechanical support tailored to commercial,
        industrial, and specialty environments.
      </p>
<a
  href="/contact"
  style="
    display:inline-flex;
    align-items:center;
    justify-content:center;
    padding:12px 22px;
    margin-top:34px;
    border:1px solid rgba(15,39,66,0.14);
    background:rgba(255,255,255,0.7);
    color:#081626;
    font-size:11px;
    font-weight:700;
    letter-spacing:1.5px;
    text-transform:uppercase;
    text-decoration:none;
    transition:all 0.25s ease;
    backdrop-filter:blur(4px);
  "
  onmouseover="
    this.style.background='#081626';
    this.style.color='white';
    this.style.borderColor='#081626';
  "
  onmouseout="
    this.style.background='rgba(255,255,255,0.7)';
    this.style.color='#081626';
    this.style.borderColor='rgba(15,39,66,0.14)';
  "
>
  Learn More
</a>
    </div>

    <div style="
      display:grid;
      grid-template-columns:repeat(3, 1fr);
      gap:28px;
    ">

      <div class="card">
        <h3>HVAC System Design</h3>

        <p>
          Engineered mechanical systems designed around
performance, constructability, operational efficiency,
and long-term reliability.
        </p>
      </div>

<div class="card">
  <h3>Tenant Improvements</h3>

  <p>
    Mechanical coordination and HVAC modifications
    tailored to commercial renovations,
    tenant build-outs, and evolving facility requirements.
  </p>
</div>


<div class="card">
  <h3>Mechanical Evaluations</h3>

  <p>
    Comprehensive HVAC assessments focused on
    existing building conditions, system performance,
    retrofit planning, and long-term operational strategy.
  </p>
</div>

<div class="card">
  <h3>Equipment Coordination</h3>

  <p>
    Mechanical layouts and equipment planning
    coordinated around field conditions,
    installation efficiency, and construction integration.
  </p>
</div>

<div class="card">
  <h3>Energy Efficiency Upgrades</h3>

  <p>
    Strategic HVAC upgrades focused on improving
    system efficiency, reducing operational costs,
    and enhancing long-term performance.
  </p>
</div>

<div class="card">
  <h3>Industrial Facilities</h3>

  <p>
    HVAC support tailored to warehouses,
    industrial operations, and large-scale
    commercial environments with demanding
    operational requirements.
  </p>
</div>

    </div>

  </div>

</section>


<!-- DESIGN & CONSULTING -->
<section style="
  background:#f4f6f8;
  padding:120px 20px;
">

  <div class="container">

    <div style="
      background:
        linear-gradient(
          135deg,
          #ffffff 0%,
          #f8fafc 100%
        );
      border-radius:18px;
      padding:120px 110px;
      position:relative;
      overflow:hidden;
      box-shadow:
        0 24px 70px rgba(15,39,66,0.08);
      border:1px solid rgba(15,39,66,0.06);
    ">

      <!-- RED ACCENT LINE -->
      <div style="
        position:absolute;
        left:0;
        top:0;
        width:6px;
        height:100%;
        background:#b4232c;
      "></div>

      <!-- SUBTLE LOGO -->
      <img
        src="/blacklogo.png"
        alt="RJP Logo"
        style="
          position:absolute;
          top:50%;
          right:-70px;
          transform:translateY(-50%);
          width:760px;
          opacity:0.025;
          pointer-events:none;
          filter:grayscale(100%);
        "
      />

      <div style="
        position:relative;
        z-index:2;
        max-width:100%;
      ">

        <p style="
          color:#b4232c;
          font-weight:800;
          letter-spacing:3px;
          text-transform:uppercase;
          margin-bottom:24px;
          font-size:20px;
        ">
          HVAC Design & Consulting
        </p>

<h2 style="
  font-size:clamp(30px,4vw,58px);
  line-height:1.12;
  margin-bottom:34px;
  color:#081626;
  letter-spacing:-1px;
  font-weight:600;
  max-width:100%;
">
  Engineered HVAC Design Built Around
  Performance, Coordination &
  Long-Term Reliability
</h2>

        <div style="
          width:90px;
          height:4px;
          background:#b4232c;
          margin-bottom:40px;
        "></div>

        <p style="
          color:#5b6573;
          font-size:20px;
          line-height:1.95;
          max-width:760px;
          margin-bottom:54px;
          font-style:italic;
        ">
          RJP Mechanical provides commercial HVAC consulting,
          coordination, and engineered system support focused on
          constructability, energy efficiency,
          operational performance, and real-world installation demands.
        </p>

<!-- BUTTONS -->
<div style="
  display:flex;
  justify-content:center;
  gap:20px;
  flex-wrap:wrap;
">

          <a
            href="/contact"
            class="btn"
            style="
              padding:14px 28px;
font-size:12px;
              letter-spacing:1.5px;
            "
          >
            Start Your Project
          </a>

          <a
            href="/about"
            class="btn-outline"
            style="
             padding:14px 28px;
font-size:12px;
              letter-spacing:1.5px;
            "
          >
            Learn More
          </a>

        </div>

      </div>

    </div>

  </div>

</section>


  <!-- SPECIALTY ENVIRONMENTS -->
<section style="
  background:#f4f6f8;
  padding:110px 20px;
">

  <div class="container">

    <div style="
      text-align:center;
      max-width:950px;
      margin:0 auto 80px auto;
    ">

      <p style="
        color:#b4232c;
        font-weight:800;
        letter-spacing:2px;
        text-transform:uppercase;
        margin-bottom:18px;
        font-size:20px;
      ">
        Specialty HVAC Environments
      </p>

      <h2 style="
        font-size:clamp(38px,4.5vw,58px);
        line-height:1.12;
        margin-bottom:30px;
        font-weight:700;
        letter-spacing:-1px;
        color:#081626;
      ">
        Precision HVAC Solutions for Controlled Spaces
      </h2>

      <div style="
        width:80px;
        height:4px;
        background:#b4232c;
        margin:0 auto 34px auto;
      "></div>

      <p style="
        font-size:20px;
        line-height:1.9;
        color:#5b6573;
        max-width:820px;
        margin:auto;
        font-style:italic;
      ">
        HVAC consulting support for facilities requiring
        tighter environmental control,
        ventilation coordination,
        airflow management,
        and pressure relationships.
      </p>
<a
  href="/contact"
  style="
    display:inline-flex;
    align-items:center;
    justify-content:center;
    padding:12px 22px;
    margin-top:34px;
    border:1px solid rgba(15,39,66,0.14);
    background:rgba(255,255,255,0.7);
    color:#081626;
    font-size:11px;
    font-weight:700;
    letter-spacing:1.5px;
    text-transform:uppercase;
    text-decoration:none;
    transition:all 0.25s ease;
    backdrop-filter:blur(4px);
  "
  onmouseover="
    this.style.background='#081626';
    this.style.color='white';
    this.style.borderColor='#081626';
  "
  onmouseout="
    this.style.background='rgba(255,255,255,0.7)';
    this.style.color='#081626';
    this.style.borderColor='rgba(15,39,66,0.14)';
  "
>
  Learn More
</a>
    </div>

    <!-- GRID -->
    <div style="
      display:grid;
      grid-template-columns:repeat(4, 1fr);
      gap:28px;
    ">

      <!-- CARD -->
      <div class="card">
        <h3>Cold Storage</h3>

<p>
  Mechanical systems designed for cold storage environments
  requiring dependable temperature stability,
  energy-efficient operation,
  and long-term reliability in demanding conditions.
</p>
      </div>

      <!-- CARD -->
      <div class="card">
        <h3>Pressure-Controlled Spaces</h3>

<p>
  Engineered HVAC support for controlled environments
  requiring precise airflow management,
  pressure relationships, and ventilation coordination.
</p>
      </div>

<!-- CARD -->
<div class="card">
  <h3>Data Centers</h3>

<p>
  Advanced cooling systems engineered for modern
  data environments, featuring precision climate control,
  containment strategies, redundancy planning,
  and scalable infrastructure designed to support
  high-density equipment and continuous operational uptime.
</p>
</div>

      <!-- CARD -->
      <div class="card">
        <h3>Specialized Applications</h3>

<p>
  Specialized HVAC support tailored to unique
  operational requirements, environmental conditions,
  and complex commercial applications.
</p>
      </div>

    </div>

  </div>

</section>


  <style>

@media(max-width:1000px){

  div[style*="grid-template-columns:repeat(4, 1fr)"],
  div[style*="grid-template-columns:repeat(4,1fr)"],
  div[style*="grid-template-columns:repeat(3, 1fr)"],
  div[style*="grid-template-columns:repeat(3,1fr)"],
  div[style*="grid-template-columns:repeat(2, 1fr)"],
  div[style*="grid-template-columns:repeat(2,1fr)"]{
    grid-template-columns:1fr !important;
  }

}

@media(max-width:768px){

  h1{
    font-size:44px !important;
    line-height:1.1 !important;
  }

  h2{
    font-size:36px !important;
    line-height:1.15 !important;
    word-break:normal !important;
    overflow-wrap:normal !important;
  }

  section{
    padding-left:20px !important;
    padding-right:20px !important;
  }

  div[style*="padding:120px 110px"]{
    padding:60px 28px !important;
  }

  div[style*="letter-spacing:-2px"]{
    font-size:30px !important;
    line-height:1.15 !important;
  }

img[style*="width:760px"]{
  width:320px !important;
  right:20px !important;
  opacity:0.04 !important;
}

}
  </style>

</Layout>