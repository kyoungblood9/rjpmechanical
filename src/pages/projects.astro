    "></div>

    <p style="
      color:#5b6573;
      font-size:18px;
      line-height:1.9;
      margin-bottom:30px;
    ">
      Detailed HVAC coordination model supporting
      equipment integration, duct routing,
      constructability review, and multi-system
      coordination throughout a commercial facility.
    </p>

    <div style="
      display:flex;
      flex-direction:column;
      gap:18px;
    ">

      <div>✓ HVAC equipment coordination</div>

      <div>✓ Multi-system integration</div>

      <div>✓ Constructability review</div>

      <div>✓ Detailed routing visualization</div>

    </div>

  </div>

  <!-- IMAGES -->
  <div style="
    max-width:600px;
    margin:0 auto;
  ">

    <img
      src="/images/projects3.JPG"
      alt="Commercial HVAC Coordination Model"
      style="
        width:100%;
        border-radius:16px;
        display:block;
        margin:0 auto 20px auto;
        box-shadow:0 20px 50px rgba(0,0,0,0.12);
        transition:all .45s ease;
      "
      onmouseover="
        this.style.transform='translateY(-12px) scale(1.08)';
        this.style.boxShadow='0 35px 80px rgba(0,0,0,0.20)';
      "
      onmouseout="
        this.style.transform='translateY(0) scale(1)';
        this.style.boxShadow='0 20px 50px rgba(0,0,0,0.12)';
      "
    />

    <img
      src="/images/projects4.JPG"
      alt="Exploded HVAC Coordination Model"
      style="
        width:100%;
        border-radius:16px;
        display:block;
        margin:0 auto 20px auto;
        box-shadow:0 20px 50px rgba(0,0,0,0.12);
        transition:all .45s ease;
      "
      onmouseover="
        this.style.transform='translateY(-12px) scale(1.08)';
        this.style.boxShadow='0 35px 80px rgba(0,0,0,0.20)';
      "
      onmouseout="
        this.style.transform='translateY(0) scale(1)';
        this.style.boxShadow='0 20px 50px rgba(0,0,0,0.12)';
      "
    />

  </div>

</div>

  </div>

</section>

<!-- FEATURED PROJECT 3 -->

<section style="
  background:#ffffff;
  padding:120px 20px;
">

  <div class="container">

<div style="
  display:grid;
  grid-template-columns:1.2fr 0.8fr;
  gap:60px;
  align-items:center;
">

  <!-- IMAGES -->
  <div style="
    max-width:600px;
    margin:0 auto;
  ">

    <img
      src="/images/projects5.JPG"
      alt="Commercial Tenant Fit-Out HVAC Design"
      style="
        width:100%;
        border-radius:16px;
        display:block;
        margin:0 auto 20px auto;
        box-shadow:0 20px 50px rgba(0,0,0,0.12);
        transition:all .45s ease;
      "
      onmouseover="
        this.style.transform='translateY(-12px) scale(1.08)';
        this.style.boxShadow='0 35px 80px rgba(0,0,0,0.20)';
      "
      onmouseout="
        this.style.transform='translateY(0) scale(1)';
        this.style.boxShadow='0 20px 50px rgba(0,0,0,0.12)';
      "
    />

    <img
      src="/images/projects6.JPG"
      alt="Commercial Tenant Improvement HVAC Layout"
      style="
        width:100%;
        border-radius:16px;
        display:block;
        margin:0 auto 20px auto;
        box-shadow:0 20px 50px rgba(0,0,0,0.12);
        transition:all .45s ease;
      "
      onmouseover="
        this.style.transform='translateY(-12px) scale(1.08)';
        this.style.boxShadow='0 35px 80px rgba(0,0,0,0.20)';
      "
      onmouseout="
        this.style.transform='translateY(0) scale(1)';
        this.style.boxShadow='0 20px 50px rgba(0,0,0,0.12)';
      "
    />

  </div>

  <!-- CONTENT -->
  <div>

    <p style="
      color:#b4232c;
      font-weight:800;
      letter-spacing:2px;
      text-transform:uppercase;
      margin-bottom:18px;
      font-size:14px;
    ">
      Representative Project Experience
    </p>

    <h2 style="
      font-size:48px;
      line-height:1.1;
      color:#081626;
      margin-bottom:24px;
    ">
      Commercial Tenant Fit-Out
    </h2>

    <div style="
      width:70px;
      height:4px;
      background:#b4232c;
      margin-bottom:30px;
    "></div>

    <p style="
      color:#5b6573;
      font-size:18px;
      line-height:1.9;
      margin-bottom:30px;
    ">
      HVAC design and coordination for commercial
      tenant improvements including rooftop equipment
      integration, supply and return air distribution,
      diffuser placement, and permit-ready mechanical
      documentation.
    </p>

    <div style="
      display:flex;
      flex-direction:column;
      gap:18px;
    ">

      <div>✓ Rooftop RTU coordination</div>

      <div>✓ Duct routing and diffuser layout</div>

      <div>✓ Permit-ready mechanical plans</div>

      <div>✓ Tenant improvement HVAC design</div>

    </div>

  </div>

</div>

  </div>

</section>

<!-- FEATURED PROJECT 4 -->

<section style="
  background:#f4f6f8;
  padding:120px 20px;
">

  <div class="container">

    <div class="featured-project-grid">

      <!-- CONTENT -->
      <div class="featured-content">

        <p style="
          color:#b4232c;
          font-weight:800;
          letter-spacing:2px;
          text-transform:uppercase;
          margin-bottom:18px;
          font-size:14px;
        ">
          Representative Project Experience
        </p>

        <h2 style="
          font-size:48px;
          line-height:1.1;
          color:#081626;
          margin-bottom:24px;
        ">
          Commercial Renovation HVAC Coordination
        </h2>

        <div style="
          width:70px;
          height:4px;
          background:#b4232c;
          margin-bottom:30px;
        "></div>

        <p style="
          color:#5b6573;
          font-size:18px;
          line-height:1.9;
          margin-bottom:30px;
        ">
          Comprehensive HVAC coordination and visualization
          package supporting commercial renovation work,
          equipment integration, routing development,
          existing building coordination, and permit-ready
          mechanical documentation.
        </p>

        <div style="
          display:flex;
          flex-direction:column;
          gap:18px;
        ">
          <div>✓ 3D mechanical system coordination</div>
          <div>✓ Existing building integration</div>
          <div>✓ Multi-system duct routing</div>
          <div>✓ Mechanical room / basement coordination</div>
          <div>✓ RTU / AHU integration</div>
          <div>✓ Riser and distribution visualization</div>
          <div>✓ Constructability-focused layout development</div>
        </div>

      </div>

      <!-- TOP RIGHT IMAGES -->
      <div class="featured-stack">

        <img
          src="/images/projects7.JPG"
          alt="Commercial Renovation HVAC Coordination"
          class="project-image"
        />

        <img
          src="/images/projects8.JPG"
          alt="Commercial Renovation HVAC Coordination"
          class="project-image"
        />

      </div>

      <!-- BOTTOM LEFT IMAGE -->
      <div class="featured-bottom-1">

        <img
          src="/images/projects9.JPG"
          alt="Commercial Renovation HVAC Coordination"
          class="project-image"
        />

      </div>

      <!-- BOTTOM RIGHT IMAGE -->
      <div class="featured-bottom-2">

        <img
          src="/images/projects10.JPG"
          alt="Commercial Renovation HVAC Coordination"
          class="project-image"
        />

      </div>

    </div>

  </div>

</section>

<style>

.featured-project-grid {
  display:grid;
  grid-template-columns:1fr 1fr;
  grid-template-areas:
    "content stack"
    "bottom1 bottom2";
  gap:15px 60px;
  align-items:start;
}

.featured-content {
  grid-area:content;
}

.featured-stack {
  grid-area:stack;
  display:flex;
  flex-direction:column;
  gap:30px;
}

.featured-bottom-1 {
  grid-area:bottom1;
  margin-top:35px;
}
.featured-bottom-1 .project-image {
  max-width:600px;
}

.featured-bottom-2 {
  grid-area:bottom2;
  margin-top:30px;
}

.project-image {
  width:100%;
  max-width:450px;
  margin:0 auto;
  display:block;
  border-radius:16px;

  box-shadow:0 20px 50px rgba(0,0,0,0.12);

  transition:
    transform .45s ease,
    box-shadow .45s ease;
}

.project-image:hover {
  transform:translateY(-12px) scale(1.08);
  box-shadow:0 35px 80px rgba(0,0,0,0.20);
}

@media (max-width:900px) {

  section div[style*="grid-template-columns:1.2fr 0.8fr"],
  section div[style*="grid-template-columns:0.8fr 1.2fr"] {
    display:grid !important;
    grid-template-columns:1fr !important;
    gap:40px !important;
  }

  .featured-project-grid {
    grid-template-columns:1fr;
    grid-template-areas:
      "content"
      "stack"
      "bottom1"
      "bottom2";
    gap:40px;
  }

  .featured-content h2 {
    font-size:34px !important;
  }

  .featured-stack {
    gap:40px;
  }

  .featured-bottom-1 {
    margin-top:0;
    width:100%;
  }

  .project-image {
    width:100%;
    max-width:100%;
  }

}
</style>

</Layout>