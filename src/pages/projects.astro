---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Project Experience | RJP Mechanical">

<!-- HERO -->

<section style="
  position:relative;
  overflow:hidden;
  padding:70px 20px 50px;
  text-align:center;
  color:white;

  background:
    linear-gradient(
      rgba(8,22,38,0.82),
      rgba(8,22,38,0.82)
    ),
    url('/images/projecthero.jpg');

  background-size:cover;
  background-position:center;
  background-repeat:no-repeat;
">

  <div style="
    max-width:950px;
    margin:auto;
  ">

    <p style="
      color:#b4232c;
      font-weight:800;
      letter-spacing:2px;
      text-transform:uppercase;
      margin-bottom:16px;
      font-size:22px;
    ">
      Project Experience
    </p>

    <h1 style="
      font-size:clamp(36px,4vw,56px);
      line-height:1.15;
      margin-bottom:24px;
      font-weight:700;
      letter-spacing:-1px;
    ">
      Selected Projects
    </h1>

    <div style="
      width:80px;
      height:4px;
      background:#b4232c;
      margin:0 auto 24px auto;
    "></div>

    <p style="
      font-size:18px;
      line-height:1.8;
      color:#d7d7d7;
      max-width:820px;
      margin:auto;
    ">
      Delivering HVAC consulting, commissioning, design,
      coordination, and construction support with a focus
      on quality, efficiency, and practical implementation.
    </p>

  </div>

</section>


<!-- FEATURED PROJECT -->
<section style="
  background:#ffffff;
  padding:120px 20px;
">

  <div class="container">

    <div style="
      display:grid;
      grid-template-columns:1.2fr 0.8fr;
      gap:60px;
      align-items:center;
    ">

<!-- IMAGE -->
<div style="
  max-width:600px;
  margin:0 auto;
">

<img
  src="/images/projects1.JPG"
  alt="Mixed Use Commercial Coordination Model"
  style="
    width:100%;
    border-radius:16px;
    display:block;
    margin:0 auto 20px auto;
    box-shadow:0 20px 50px rgba(0,0,0,0.12);
    transition:all .45s ease;
  "
  onmouseover="
    this.style.transform='translateY(-12px) scale(1.08)';
    this.style.boxShadow='0 35px 80px rgba(0,0,0,0.20)';
  "
  onmouseout="
    this.style.transform='translateY(0) scale(1)';
    this.style.boxShadow='0 20px 50px rgba(0,0,0,0.12)';
  "
/>

<img
  src="/images/projects2.JPG"
  alt="Exploded Building Coordination Model"
  style="
    width:100%;
    border-radius:16px;
    display:block;
    margin:0 auto 20px auto;
    box-shadow:0 20px 50px rgba(0,0,0,0.12);
    transition:all .45s ease;
  "
  onmouseover="
    this.style.transform='translateY(-12px) scale(1.08)';
    this.style.boxShadow='0 35px 80px rgba(0,0,0,0.20)';
  "
  onmouseout="
    this.style.transform='translateY(0) scale(1)';
    this.style.boxShadow='0 20px 50px rgba(0,0,0,0.12)';
  "
/>

</div>

      <!-- CONTENT -->
      <div>

        <p style="
          color:#b4232c;
          font-weight:800;
          letter-spacing:2px;
          text-transform:uppercase;
          margin-bottom:18px;
          font-size:14px;
        ">
          Featured Project
        </p>

        <h2 style="
          font-size:48px;
          line-height:1.1;
          color:#081626;
          margin-bottom:24px;
        ">
          Mixed-Use / Multi-Level Commercial Coordination
        </h2>

        <div style="
          width:70px;
          height:4px;
          background:#b4232c;
          margin-bottom:30px;
        "></div>

        <p style="
          color:#5b6573;
          font-size:18px;
          line-height:1.9;
          margin-bottom:30px;
        ">
          Commercial HVAC coordination model developed
          to support multi-floor system integration,
          equipment placement, routing efficiency,
          and constructability review.
        </p>

        <div style="
          display:flex;
          flex-direction:column;
          gap:18px;
        ">

          <div>✓ Mechanical system coordination</div>

          <div>✓ 3D routing visualization</div>

          <div>✓ Multi-floor integration</div>

          <div>✓ Constructability-focused layout development</div>

        </div>

      </div>

    </div>

  </div>

</section>
<!-- FEATURED PROJECT 2 -->

<section style="
  background:#f4f6f8;
  padding:120px 20px;
">

  <div class="container">

<div style="
  display:grid;
  grid-template-columns:0.8fr 1.2fr;
  gap:60px;
  align-items:center;
">

  <!-- CONTENT -->
  <div>

    <p style="
