---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About | RJP Mechanical">

  <!-- HERO -->
  <section style="
    position: relative;
    min-height: 62vh;
padding: 110px 80px 80px;
    display: flex;
    align-items: center;
    color: white;
    background: url('/images/mechanical.jpg') center/cover no-repeat;
    overflow:hidden;
  ">

    <!-- OVERLAY -->
    <div style="
      position:absolute;
      inset:0;
      background: linear-gradient(
        90deg,
        rgba(10,25,45,0.94) 0%,
        rgba(10,25,45,0.82) 50%,
        rgba(10,25,45,0.45) 100%
      );
    "></div>

    <!-- HERO CONTENT -->
    <div style="
      position:relative;
      max-width:760px;
      z-index:2;
    ">

      <p style="
        color:#b4232c;
        font-weight:700;
        letter-spacing:2px;
        text-transform:uppercase;
        margin-bottom:18px;
        font-size:24px;
      ">
        About RJP Mechanical
      </p>

      <h1 style="
        font-size:47px;
        line-height:1.05;
        letter-spacing:-2px;
        margin-bottom:22px;
      ">
        Precision-Engineered HVAC Solutions Built for Performance & Reliability
      </h1>

      <div style="
        width:80px;
        height:4px;
        background:#b4232c;
        margin-bottom:30px;
      "></div>

      <p style="
        font-size:18px;
        color:#d7d7d7;
        max-width:700px;
        line-height:1.8;
        margin-bottom:40px;
      ">
At RJP Mechanical, we serve as your strategic partner in commercial and industrial climate control. Our focus is on designing practical, energy-efficient HVAC systems that prioritize performance, constructability, and long-term reliability.
      </p>

      <!-- BUTTONS -->
      <div style="
        display:flex;
        gap:16px;
        flex-wrap:wrap;
      ">

        <a href="/contact" class="btn">
          Contact Us
        </a>

        <a href="/services" class="btn-outline-light">
          Our Services
        </a>

      </div>

    </div>

  </section>

  <!-- COMPANY OVERVIEW -->
  <section style="
    background:#ffffff;
    overflow:hidden;
  ">

    <div style="
      display:grid;
      grid-template-columns: 1fr 1fr;
      align-items:center;
    ">

      <!-- IMAGE -->
      <div>
<img
  src="/images/hardhat.png"
  alt="Commercial HVAC Team"
  style="
    width:100%;
    height:620px;
    object-fit:cover;
    display:block;
  "
/>
      </div>

      <!-- CONTENT -->
      <div style="
        padding:70px;
        position:relative;
      ">

        <!-- BACKGROUND LOGO -->
        <img
          src="/blacklogo.png"
          alt="RJP Logo"
          style="
            position:absolute;
            right:50%;
            top:50%;
            transform:translate(50%, -50%);
            width:680px;
            opacity:0.15;
            pointer-events:none;
            z-index:1;
            filter:
              brightness(0)
              saturate(100%)
              invert(18%)
              sepia(61%)
              saturate(2460%)
              hue-rotate(336deg)
              brightness(91%)
              contrast(91%);
          "
        />

        <div style="
          position:relative;
          z-index:2;
        ">

          <p style="
            color:#b4232c;
            font-weight:700;
            letter-spacing:2px;
            text-transform:uppercase;
            margin-bottom:18px;
            font-size:14px;
          ">
          </p>

          <h2 style="
            font-size:46px;
            line-height:1.1;
            margin-bottom:22px;
            color:#081626;
            letter-spacing:-1px;
          ">
            About Us
          </h2>

          <div style="
            width:70px;
            height:4px;
            background:#b4232c;
            margin-bottom:28px;
          "></div>

          <p style="
            color:#374151;
            line-height:1.9;
            font-size:17px;
  font-weight:500;
            margin-bottom:24px;
          ">
         RJP Mechanical was founded after more than 20 years of experience in the HVAC industry, with a career that began in the field and evolved through design, coordination, and project leadership. Having worked across every phase of the profession, RJP Mechanical understands both the technical requirements of a project and the realities of construction, delivering solutions that are practical, efficient, and field-proven.
          </p>

          <p style="
            color:#374151;
            line-height:1.9;
            font-size:17px;
  font-weight:500;
            margin-bottom:24px;
          ">
           We specialize in HVAC consulting & design, commissioning, tenant improvements, system evaluations, equipment coordination, and the management of specialty environments that demand precise climate control. 
          </p>

          <p style="
            color:#374151;
            line-height:1.9;
            font-size:17px;
  font-weight:500;
          ">
Our approach is rooted in practical engineering and real-world experience, emphasizing implementable solutions, energy efficiency, and the long-term reliability of building operations.
          </p>

        </div>

      </div>

    </div>

  </section>

 <!-- EXPERIENCE CARDS -->
<section
  class="section container"
  style="
    text-align:center;
    padding-top:120px;
    padding-bottom:120px;
  "
>

  <h2 style="
    font-size:42px;
    margin-bottom:10px;
    letter-spacing:-1px;
  ">
    Why Contractors & Owners Choose RJP
  </h2>

  <div style="
    width:80px;
    height:4px;
    background:#b4232c;
    margin:20px auto 40px auto;
  "></div>

  <p style="
    color:#5f5f5f;
    max-width:820px;
    margin:0 auto 70px auto;
    line-height:1.8;
    font-size:16px;
  ">
    Delivering practical, high-performance HVAC solutions
    focused on efficiency, coordination, constructability,
    and long-term operational reliability.
  </p>

  <div style="
    display:grid;
    grid-template-columns: repeat(2, 1fr);
    gap:30px;
  ">

    <!-- CARD -->
    <div class="card">
      <h3>Industry Leadership</h3>

      <p>
        With decades of HVAC experience, RJP Mechanical
        specializes in engineered commercial and industrial
        mechanical solutions designed for demanding facilities.
      </p>
    </div>

    <!-- CARD -->
    <div class="card">
      <h3>Customized Solutions</h3>

      <p>
        Every HVAC system is tailored to the specific
        operational needs of the facility, maximizing
        efficiency, performance, and long-term value.
      </p>
    </div>

    <!-- CARD -->
    <div class="card">
      <h3>Advanced Energy Efficiency</h3>

      <p>
        We help businesses reduce operational costs and
        environmental impact through modern, energy-efficient
        HVAC technologies and strategic system planning.
      </p>
    </div>

    <!-- CARD -->
    <div class="card">
      <h3>Certified & Compliant</h3>

      <p>
        Our work aligns with ASHRAE, EPA, and LEED
        standards to ensure commercial-grade HVAC quality,
        safety, and performance compliance.
      </p>
    </div>

  </div>

</section>

<!-- DEDICATION TO EXCELLENCE -->
<section style="
  background:#f4f6f8;
  padding:120px 20px;
">

  <div
    class="container"
    style="
      max-width:1100px;
      margin:auto;
    "
  >

    <!-- FEATURE CARD -->
    <div style="
      background:white;
      border-radius:28px;
      padding:90px 80px;
      position:relative;
      overflow:hidden;
      box-shadow:
        0 20px 60px rgba(0,0,0,0.08);
      border:1px solid rgba(0,0,0,0.05);
    ">

<!-- SUBTLE CENTER BACKGROUND LOGO -->
<img
  src="/blacklogo.png"
  alt="RJP Logo"
  style="
    position:absolute;
    top:50%;
    left:50%;
    transform:translate(-50%, -50%);
    width:720px;
    opacity:0.035;
    pointer-events:none;
    filter:grayscale(100%);
  "
/>

      <div style="
        position:relative;
        z-index:2;
        max-width:820px;
      ">

        <p style="
          color:#b4232c;
          font-weight:700;
          letter-spacing:2px;
          text-transform:uppercase;
          margin-bottom:18px;
          font-size:14px;
        ">
          Our Commitment
        </p>

        <h2 style="
          font-size:52px;
          line-height:1.1;
          margin-bottom:24px;
          color:#081626;
          letter-spacing:-1px;
        ">
          Our Dedication to Excellence
        </h2>

        <div style="
          width:80px;
          height:4px;
          background:#b4232c;
          margin-bottom:35px;
        "></div>

        <p style="
          color:#5b6573;
          font-size:18px;
          line-height:1.9;
        ">
          At RJP Mechanical, we go beyond the design and installation
          of HVAC systems — we deliver comprehensive mechanical
          solutions focused on energy efficiency, system longevity,
          and uninterrupted business operations.
          <br /><br />
          Our consultative approach centers on understanding your
          facility’s unique operational needs, performing detailed
          system evaluations, and implementing practical strategies
          designed to improve long-term performance, reliability,
          and cost savings.
        </p>

      </div>

    </div>

  </div>

</section>
 
  <style>

    .dark-card{
      background:rgba(255,255,255,0.04);
      border:1px solid rgba(255,255,255,0.08);
      border-radius:18px;
      padding:40px 30px;
      transition:0.25s ease;
    }

    .dark-card:hover{
      transform:translateY(-6px);
      border-color:rgba(255,255,255,0.18);
    }

    .dark-card h3{
      font-size:24px;
      line-height:1.3;
      margin:0;
    }

@media(max-width:1000px){

  div[style*="grid-template-columns: 1fr 1fr"]{
    display:block !important;
  }

  div[style*="grid-template-columns: 1fr 1fr"] img{
    height:auto !important;
    width:100% !important;
    object-fit:cover !important;
  }

}

@media(max-width:900px){

  h1{
    font-size:48px !important;
  }

  h2{
    font-size:36px !important;
  }

  div[style*="grid-template-columns: repeat(3, 1fr)"]{
    grid-template-columns:1fr !important;
  }

  div[style*="grid-template-columns: repeat(2, 1fr)"],
  div[style*="grid-template-columns:repeat(2,1fr)"]{
    grid-template-columns:1fr !important;
  }

  section{
    padding-left:20px !important;
    padding-right:20px !important;
  }

}

</style>
</Layout>